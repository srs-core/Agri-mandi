# Environment
APP_ENV=development
API_V1_PREFIX=/api/v1
PROJECT_NAME=AgriMandi API

# Database: PostGIS for local development. Keep credentials out of version control.
DATABASE_URL=postgresql+psycopg://agrimandi:change-me@localhost:5432/agrimandi

# Generate separate long random values for local development; never reuse these in production.
JWT_SECRET_KEY=replace-with-a-long-random-development-secret
JWT_REFRESH_SECRET_KEY=replace-with-a-different-long-random-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14

# Comma-separated explicit origins only.
CORS_ORIGINS=http://localhost:5173
