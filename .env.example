# Docker Compose local-development values. Replace all placeholders before starting the stack.
POSTGRES_DB=agrimandi
POSTGRES_USER=agrimandi
POSTGRES_PASSWORD=replace-with-a-local-development-password
JWT_SECRET_KEY=replace-with-a-long-random-development-access-secret
JWT_REFRESH_SECRET_KEY=replace-with-a-different-long-random-development-refresh-secret
CORS_ORIGINS=http://localhost:5173
